* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  line-height: 1.65;
  font-size: 16px;
  padding: 32px 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.container {
  max-width: 800px;
  margin: 0 auto;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 40px 32px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
}

@media (max-width: 600px) {
  body {
    padding: 16px 8px;
  }
  .container {
    padding: 24px 18px;
    border-radius: 8px;
  }
}

h1 {
  font-size: 2rem;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
  margin-bottom: 8px;
}

.last-updated {
  font-size: 0.95rem;
  color: var(--text-muted);
  margin-bottom: 24px;
}

p {
  margin-bottom: 16px;
  color: var(--text-main);
}

hr {
  border: none;
  height: 1px;
  background-color: var(--divider-color);
  margin: 32px 0;
}

h2 {
  font-size: 1.35rem;
  font-weight: 600;
  color: #0f172a;
  margin-top: 28px;
  margin-bottom: 14px;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 6px;
}

h3 {
  font-size: 1.1rem;
  font-weight: 600;
  color: #1e293b;
  margin-top: 20px;
  margin-bottom: 10px;
}

ul {
  margin-left: 24px;
  margin-bottom: 18px;
}

li {
  margin-bottom: 8px;
  color: var(--text-main);
}

strong {
  color: #0f172a;
  font-weight: 600;
}

code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 0.9em;
  background-color: var(--code-bg);
  color: #0369a1;
  padding: 2px 6px;
  border-radius: 4px;
  border: 1px solid var(--border-color);
}

a {
  color: var(--primary);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}
